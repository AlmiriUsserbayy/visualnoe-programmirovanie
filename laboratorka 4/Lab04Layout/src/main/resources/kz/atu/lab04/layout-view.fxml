<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" minHeight="500.0" minWidth="700.0" xmlns="http://javafx.com" xmlns:fx="http://fxml.com" fx:controller="kz.atu.lab04.LayoutController">
    <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-background-color: #f0f0f0;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Панель управления студентами" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Добавить" onAction="#onSaveClick" />
                <Button fx:id="btnClear" text="Очистить" onAction="#onClearClick" />
            </children>
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
            </padding>
        </HBox>
    </top>

    <!-- ЛЕВАЯ НАВИГАЦИЯ -->
    <left>
        <VBox prefWidth="160.0" spacing="8.0" style="-fx-border-color: #cccccc; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <children>
                <Button maxWidth="1.7976931348623157E308" text="Студенты" />
                <Button maxWidth="1.7976931348623157E308" text="Группы" />
                <Button maxWidth="1.7976931348623157E308" text="Настройки" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </left>

    <!-- ЦЕНТРАЛЬНАЯ ЧАСТЬ -->
    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <!-- Форма ввода на GridPane -->
                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="60.0" />
                        <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="ФИО:" />
                        <Label text="Группа:" GridPane.rowIndex="1" />
                        <Label text="Курс:" GridPane.rowIndex="2" />
                        <TextField fx:id="txtFullName" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" />
                        <TextField fx:id="txtGroup" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <ComboBox fx:id="cmbCourse" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Button fx:id="btnSave" text="Сохранить" onAction="#onSaveClick" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    </children>
                </GridPane>

                <!-- Таблица со студентами (Растет вертикально благодаря VBox.vgrow="ALWAYS") -->
                <TableView fx:id="tblStudents" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFullName" text="ФИО" prefWidth="250.0"/>
                        <TableColumn fx:id="colGroup" text="Группа" prefWidth="120.0"/>
                        <TableColumn fx:id="colCourse" text="Курс" prefWidth="100.0"/>
                    </columns>
                </TableView>
            </children>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
        </VBox>
    </center>

    <!-- НИЖНИЙ СТАТУС БАР -->
    <bottom>
        <HBox style="-fx-background-color: #e0e0e0;" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="lblStatus" text="Статус: приложение готово" />
            </children>
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>
