<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kz.atu.lab11.controller.FinanceController"
            prefWidth="960" prefHeight="620">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="10" right="10" bottom="5" left="10"/></padding>
            <Label text="Поиск:"/>
            <TextField fx:id="txtSearch" promptText="Описание операции" HBox.hgrow="ALWAYS"/>
            <Label text="Категория:"/>
            <ComboBox fx:id="cmbCategoryFilter" prefWidth="180"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableTransactions">
            <BorderPane.margin><Insets top="5" right="10" bottom="5" left="10"/></BorderPane.margin>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colDescription" text="Описание" prefWidth="260"/>
                <TableColumn fx:id="colCategory" text="Категория" prefWidth="150"/>
                <TableColumn fx:id="colType" text="Тип" prefWidth="90"/>
                <TableColumn fx:id="colAmount" text="Сумма" prefWidth="130"/>
                <TableColumn fx:id="colDate" text="Дата" prefWidth="110"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding><Insets top="5" right="10" bottom="10" left="10"/></padding>
            <GridPane hgap="10" vgap="8">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="SOMETIMES"/>
                    <ColumnConstraints hgrow="SOMETIMES"/>
                    <ColumnConstraints hgrow="SOMETIMES"/>
                </columnConstraints>
                <Label text="Описание" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="Категория" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Тип" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <Label text="Сумма" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <Label text="Дата" GridPane.columnIndex="4" GridPane.rowIndex="0"/>

                <TextField fx:id="txtDescription" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtCategory" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cmbType" prefWidth="110" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="txtAmount" prefWidth="110" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                <DatePicker fx:id="dpDate" prefWidth="140" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Добавить" onAction="#onAdd"/>
                <Button text="Изменить" onAction="#onUpdate"/>
                <Button text="Удалить" onAction="#onDelete"/>
            </HBox>

            <Label fx:id="lblCount" text="Найдено операций: 0"/>
            <Label fx:id="lblBalance" text="Доходы: 0 | Расходы: 0 | Баланс: 0"/>
            <Label fx:id="lblAverage" text="Средняя сумма операции: 0"/>
        </VBox>
    </bottom>
</BorderPane>
